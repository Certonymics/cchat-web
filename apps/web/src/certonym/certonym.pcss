/*
c.chat (Certonymics) fork addition — not an upstream element-web file.

Certonym identity badge (ADR-0006). Blue is the identity colour — Element's
green shields stay reserved for E2EE/device verification.
Imported directly by CertonymBadge.tsx (same pattern as ErrorView.pcss), so
it needs no entry in the autogenerated res/css/_components.pcss.
*/

.cchat_CertonymBadge {
    display: inline-flex;
    align-items: baseline;
    gap: 1px;
    margin-inline-start: var(--cpd-space-1x, 4px);
    font-size: 1.2rem;
    line-height: 1;
    font-weight: var(--cpd-font-weight-semibold, 600);
    color: var(--cpd-color-blue-900, #0467dd);
    user-select: none;
    cursor: default;
}

.cchat_CertonymBadge_tier {
    font-size: 0.75em;
}

.cchat_CertonymBadge_compact {
    font-size: 1rem;
}

/* "Hollow" tick: same mark, deliberately washed out — a cdot.chat identity
   with no (valid) certonym attestation. Never rendered in compact contexts. */
.cchat_CertonymBadge_unverified {
    color: var(--cpd-color-icon-quaternary, #97a4b2);
    font-weight: var(--cpd-font-weight-regular, 400);
    opacity: 0.7;
}
